<!DOCTYPE html>
<html>
    <head>
        {# Définit les métadonnées communes à toutes les pages Twig. #}
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
            {# Injecte les feuilles de style produites par Encore. #}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {# Injecte les scripts produits par Encore. #}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        {# Chaque page enfant fournit ici son contenu principal. #}
        {% block body %}{% endblock %}
    </body>
</html>
